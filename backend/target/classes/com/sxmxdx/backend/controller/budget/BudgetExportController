
package com.sxmxdx.backend.controller.budget;

import com.sxmxdx.backend.service.budget.BudgetExportService;
import org.springframework.http.*;
import org.springframework.web.bind.annotation.*;
import java.io.IOException;

@RestController
@RequestMapping("/api/budgets")
@CrossOrigin(origins = "http://localhost:3000")
public class BudgetExportController {

    private final BudgetExportService exports;

    public BudgetExportController(BudgetExportService exports) {
        this.exports = exports;
    }

    @GetMapping("/exercices/{id}/export/excel")
    public ResponseEntity<byte[]> excel(
            @PathVariable Integer id,
            @RequestParam Integer annee
    ) throws IOException {
        return ResponseEntity.ok()
            .header(
                HttpHeaders.CONTENT_DISPOSITION,
                "attachment; filename=budget_" + annee + ".xlsx"
            )
            .contentType(MediaType.parseMediaType(
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            ))
            .body(exports.excel(id));
    }

    @GetMapping("/exercices/{id}/export/pdf")
    public ResponseEntity<byte[]> pdf(
            @PathVariable Integer id,
            @RequestParam Integer annee
    ) throws IOException {
        return ResponseEntity.ok()
            .header(
                HttpHeaders.CONTENT_DISPOSITION,
                "attachment; filename=rapport_budget_" + annee + ".pdf"
            )
            .contentType(MediaType.APPLICATION_PDF)
            .body(exports.pdf(id, annee));
    }
}
